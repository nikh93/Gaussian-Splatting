<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <SurfaceView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- placement / AR controls -->
    <LinearLayout
        android:id="@+id/topPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/overlay"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/statusText"
            style="@style/OverlayText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ar_loading"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sizeText"
            style="@style/OverlayText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/overlay"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ar_back"
            android:textColor="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/resetButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/ar_replace"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/scaleGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="invisible">

            <TextView
                style="@style/OverlayText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ar_scale" />

            <com.google.android.material.slider.Slider
                android:id="@+id/scaleSlider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:value="0"
                android:valueFrom="-2"
                android:valueTo="1.3"
                app:labelBehavior="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/realSizeButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ar_real_size"
                android:textColor="@color/white" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cardboardButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/ar_cardboard"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/placeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/ar_place" />
    </LinearLayout>

    <!-- Cardboard (VR) overlay: divider between the eyes, exit and viewer settings -->
    <FrameLayout
        android:id="@+id/vrOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="48dp"
            android:background="#99FFFFFF" />

        <ImageButton
            android:id="@+id/vrCloseButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|start"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ar_exit_vr"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/vrSettingsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ar_scan_qr"
            android:src="@drawable/ic_settings"
            app:tint="@color/white" />
    </FrameLayout>
</FrameLayout>
