<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 15 forces edge-to-edge drawing for apps targeting SDK 35, which pushed the
  controls under the status and navigation bars. Keep the classic window layout;
  the overlay screens additionally pad themselves with the system bar insets.
-->
<resources>
    <style name="Theme.Gsplat" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <style name="Theme.Gsplat.Fullscreen" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
